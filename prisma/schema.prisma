generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT     @map("draft")
  PLANNING  @map("planning")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
  ARCHIVED  @map("archived")

  @@map("event_status")
}

enum EventType {
  BIRTHDAY @map("birthday")
  WEDDING  @map("wedding")
  PARTY    @map("party")
  CORPORATE @map("corporate")
  OTHER    @map("other")

  @@map("event_type")
}

enum EventMemberRole {
  EDITOR @map("editor")
  VIEWER @map("viewer")

  @@map("event_member_role")
}

model User {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authSubject            String    @unique @map("auth_subject") @db.VarChar(255)
  email                  String    @db.VarChar(320)
  displayName            String    @map("display_name") @db.VarChar(160)
  identityEventTimestamp BigInt    @default(0) @map("identity_event_timestamp")
  identityDeletedAt      DateTime? @map("identity_deleted_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                Int       @default(1)

  ownedEvents  Event[]       @relation("EventOwner")
  memberships EventMember[]
  auditLogs    AuditLog[]    @relation("AuditActor")

  @@index([email])
  @@map("users")
}

model Event {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String      @map("owner_id") @db.Uuid
  title        String      @db.VarChar(160)
  description  String?     @db.Text
  eventType    EventType   @map("event_type")
  status       EventStatus @default(DRAFT)
  startsAt     DateTime    @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime    @map("ends_at") @db.Timestamptz(6)
  timezone     String      @db.VarChar(64)
  venueText    String?     @map("venue_text") @db.VarChar(500)
  currency     String      @db.Char(3)
  budgetLimit  Decimal?    @map("budget_limit") @db.Decimal(14, 2)
  capacity     Int?
  rsvpDeadline DateTime?   @map("rsvp_deadline") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  version      Int         @default(1)

  owner            User             @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members          EventMember[]
  budgetCategories BudgetCategory[]
  auditLogs        AuditLog[]

  @@index([ownerId, status, startsAt])
  @@index([status, startsAt])
  @@map("events")
}

model EventMember {
  eventId  String          @map("event_id") @db.Uuid
  userId   String          @map("user_id") @db.Uuid
  role     EventMemberRole
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int            @default(1)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, role])
  @@map("event_members")
}

model BudgetCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, name])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("budget_categories")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model IdentityWebhookEvent {
  id             String   @id @db.VarChar(255)
  type           String   @db.VarChar(100)
  eventTimestamp BigInt   @map("event_timestamp")
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@index([processedAt])
  @@map("identity_webhook_events")
}
