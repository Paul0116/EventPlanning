# Application origins (no trailing slash)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk development application — obtain values from Clerk; never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/events

# PostgreSQL. The shown passwords are local-only Docker defaults, never shared environments.
DATABASE_URL=postgresql://gatherly:gatherly_local_only@127.0.0.1:54329/gatherly
MIGRATION_DATABASE_URL=postgresql://gatherly:gatherly_local_only@127.0.0.1:54329/gatherly
TEST_DATABASE_URL=postgresql://gatherly_test:gatherly_test_only@127.0.0.1:54330/gatherly_test

# Optional synthetic seed override. Use a Clerk development subject only in an isolated environment.
SYNTHETIC_OWNER_AUTH_SUBJECT=seed_user_alex

# Authenticated browser test — a synthetic Clerk test user only.
E2E_CLERK_USER_EMAIL=
